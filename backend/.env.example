# JWT_SEGREDO, ERP_URL e ERP_TOKEN são obrigatórios. Substitua os exemplos.
# Placeholders são rejeitados; nunca versione credenciais reais ou .env.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura do JWT. Gere com: npm run segredo:gerar
JWT_SEGREDO=troque-por-um-segredo-aleatorio
JWT_EXPIRACAO=7d

# Banco proprio do e-commerce (usuarios, enderecos, carrinho).
# Catalogo e pedidos NAO ficam aqui: vem do ERP.
DB_PATH=./data/ecommerce.db

# --- Integracao com o Kaizen ERP -------------------------------------------
ERP_URL=cole-aqui-a-URL-do-kaizen-erp
ERP_TOKEN=cole-aqui-o-API_TOKEN-do-kaizen-erp
ERP_TIMEOUT_MS=8000

# Uma origem HTTP(S) canonica, sem caminho/barra final, para acesso cruzado.
# Ausente/vazia: localhost:5173 em dev/test; sem permissao CORS em production.
# No deploy de mesma origem, remova ou esvazie esta variavel.
CORS_ORIGEM=http://localhost:5173
